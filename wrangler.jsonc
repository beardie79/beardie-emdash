{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "beardie-emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "beardie-emdash-db","database_id": "aa2f300e-17f9-4317-82ae-3ca5fd0fb9f6",
			// Run `wrangler d1 create my-emdash-site` and paste the ID here
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "beardie-emdash-media","preview_bucket_name": "beardie-emdash-media",
		},
	],
	"observability": {
		"enabled": true,
	},
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
}